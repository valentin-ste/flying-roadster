{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadster",
  "mainBinaryName": "Roadster",
  "version": "1.0.0",
  "identifier": "com.valentinste.roadster",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VALENTIN STE",
    "copyright": "© 2026 VALENTIN STE",
    "shortDescription": "A roadster flies over your desktop",
    "homepage": "https://flying-roadster-app.pages.dev",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
